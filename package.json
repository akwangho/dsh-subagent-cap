{
  "name": "dsh-subagent-cap",
  "version": "1.3.1",
  "description": "DSH (DeepSeek Harness) plugin: limits the number of concurrently running subagents per session (default 1), with reject-or-queue enforcement, a real in-flight-aware slot allocator, and a settings UI. Settings are ordinary volatile plugin Config, edited from the plugin's own settings section and persisted by DSH into the profile patch.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "subagent",
    "concurrency",
    "limit",
    "queue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akwangho/dsh-subagent-cap.git"
  },
  "homepage": "https://github.com/akwangho/dsh-subagent-cap#readme",
  "bugs": {
    "url": "https://github.com/akwangho/dsh-subagent-cap/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <1.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1 <1.0.0",
    "react": ">=18.2.0 <20.0.0"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.2-rc.1 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/pure.test.mjs test/pre-execute.test.mjs test/rpc.test.mjs test/manifest.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <1.0.0"
  }
}
